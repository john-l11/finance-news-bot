data/
datasets/
*.csv
*.json
*.parquet

# Training logs and visualizations
lightning_logs/
tensorboard/
*.log
wandb/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ==============================================================================
